# Optional: the defaults in app/config.py already match docker-compose.yml.
# Set these as environment variables to override them.
DATABASE_URL=postgresql+psycopg://geo:geo@localhost:55432/geo
TEST_DATABASE_URL=postgresql+psycopg://geo:geo@localhost:55432/geo_test

# Upload and zip-bomb limits (whole numbers above 0).
MAX_UPLOAD_MB=50
MAX_UNCOMPRESSED_MB=200
MAX_ZIP_MEMBERS=100
MAX_COMPRESSION_RATIO=100
